alert_queue = []

while True:

    print()
    print("===== SOC Active Alert Queue =====")
    print("1. Log New Alert")
    print("2. View Active Queue")
    print("3. Resolve Oldest Alert")
    print("4. Exit System")

    choice = input("Choose an option (1-4): ")

    if choice == "1":
        threat = input("Enter the threat description: ")
        alert_queue.append(threat)  
        print("Alert logged successfully!")

    elif choice == "2":
        print("--- Current Pending Alerts ---")

        for alert in alert_queue:
            print("-", alert)


    elif choice == "3":


        if len(alert_queue) > 0:
            resolved_threat = alert_queue.pop(0) 
            print("Resolved and cleared:", resolved_threat)
        else:
            print("No pending alerts. The queue is empty.")


    elif choice == "4":
        print("Exiting the SOC Alert System. Goodbye!")
        break


    else:
        print("Invalid option. Please enter 1, 2, 3, or 4.")
